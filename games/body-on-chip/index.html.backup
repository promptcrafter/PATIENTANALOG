<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Body-on-Chip Platform | Patient Analog</title>
  <style>
    :root { --bg: #000814; --sapphire: #0055ff; --emerald: #00cc66; --crimson: #ff3366; --amber: #ffaa00; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: var(--bg); color: white; min-height: 100vh; padding: 20px; }
    .container { max-width: 700px; margin: 0 auto; text-align: center; }
    h1 { font-size: 1.5rem; margin-bottom: 10px; }
    .subtitle { color: #888; margin-bottom: 20px; font-size: 14px; }
    .chip-platform {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;
      background: rgba(0,20,40,0.8); border: 2px solid rgba(0,85,255,0.3);
      border-radius: 16px; padding: 20px; margin-bottom: 20px;
    }
    .organ-chip {
      background: rgba(0,85,255,0.1); border: 2px solid rgba(0,85,255,0.3);
      border-radius: 12px; padding: 15px; cursor: pointer; transition: all 0.3s;
    }
    .organ-chip:hover { border-color: var(--sapphire); transform: scale(1.02); }
    .organ-chip.active { border-color: var(--emerald); box-shadow: 0 0 20px rgba(0,204,102,0.3); }
    .organ-chip.inactive { opacity: 0.4; }
    .organ-icon { font-size: 36px; margin-bottom: 8px; }
    .organ-name { font-weight: bold; margin-bottom: 5px; }
    .organ-status { font-size: 11px; color: #888; }
    .controls { display: flex; justify-content: center; gap: 20px; margin-bottom: 20px; }
    .control-group { text-align: left; }
    .control-label { font-size: 12px; color: #888; margin-bottom: 5px; }
    input[type="range"] { width: 150px; }
    .system-status {
      display: flex; justify-content: center; gap: 30px;
      background: rgba(0,20,40,0.5); border-radius: 8px; padding: 15px;
    }
    .status-item { text-align: center; }
    .status-value { font-size: 1.3rem; font-weight: bold; }
    .status-label { font-size: 11px; color: #666; }
    .btn { padding: 10px 20px; background: var(--sapphire); color: white; border: none; border-radius: 8px; cursor: pointer; margin: 5px; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🧫 Body-on-Chip Platform</h1>
    <p class="subtitle">Operate a 6-organ microphysiological system!</p>

    <div class="chip-platform">
      <div class="organ-chip" onclick="toggleOrgan(this)" data-organ="liver">
        <div class="organ-icon">🫁</div>
        <div class="organ-name">Liver</div>
        <div class="organ-status">Click to activate</div>
      </div>
      <div class="organ-chip" onclick="toggleOrgan(this)" data-organ="heart">
        <div class="organ-icon">❤️</div>
        <div class="organ-name">Heart</div>
        <div class="organ-status">Click to activate</div>
      </div>
      <div class="organ-chip" onclick="toggleOrgan(this)" data-organ="kidney">
        <div class="organ-icon">🫘</div>
        <div class="organ-name">Kidney</div>
        <div class="organ-status">Click to activate</div>
      </div>
      <div class="organ-chip" onclick="toggleOrgan(this)" data-organ="lung">
        <div class="organ-icon">🫁</div>
        <div class="organ-name">Lung</div>
        <div class="organ-status">Click to activate</div>
      </div>
      <div class="organ-chip" onclick="toggleOrgan(this)" data-organ="brain">
        <div class="organ-icon">🧠</div>
        <div class="organ-name">Brain</div>
        <div class="organ-status">Click to activate</div>
      </div>
      <div class="organ-chip" onclick="toggleOrgan(this)" data-organ="gut">
        <div class="organ-icon">🔬</div>
        <div class="organ-name">Gut</div>
        <div class="organ-status">Click to activate</div>
      </div>
    </div>

    <div class="controls">
      <div class="control-group">
        <div class="control-label">Flow Rate: <span id="flowVal">50</span> μL/min</div>
        <input type="range" id="flowRate" min="10" max="100" value="50" oninput="updateSystem()">
      </div>
      <div class="control-group">
        <div class="control-label">Pressure: <span id="pressVal">30</span> mmHg</div>
        <input type="range" id="pressure" min="10" max="60" value="30" oninput="updateSystem()">
      </div>
    </div>

    <div class="system-status">
      <div class="status-item">
        <div class="status-value" id="activeCount">0/6</div>
        <div class="status-label">Organs Active</div>
      </div>
      <div class="status-item">
        <div class="status-value" id="homeostasis">0%</div>
        <div class="status-label">Homeostasis</div>
      </div>
      <div class="status-item">
        <div class="status-value" id="viability">--</div>
        <div class="status-label">System Status</div>
      </div>
    </div>
  </div>

  <script>
    let activeOrgans = new Set();

    function toggleOrgan(el) {
      const organ = el.dataset.organ;
      if (activeOrgans.has(organ)) {
        activeOrgans.delete(organ);
        el.classList.remove('active');
        el.querySelector('.organ-status').textContent = 'Click to activate';
      } else {
        activeOrgans.add(organ);
        el.classList.add('active');
        el.querySelector('.organ-status').textContent = 'Online';
      }
      updateSystem();
    }

    function updateSystem() {
      const flow = document.getElementById('flowRate').value;
      const pressure = document.getElementById('pressure').value;
      document.getElementById('flowVal').textContent = flow;
      document.getElementById('pressVal').textContent = pressure;

      const count = activeOrgans.size;
      document.getElementById('activeCount').textContent = count + '/6';

      // Optimal: flow=60, pressure=35, all organs active
      const flowScore = 100 - Math.abs(flow - 60) * 1.5;
      const pressScore = 100 - Math.abs(pressure - 35) * 2;
      const organScore = (count / 6) * 100;
      const homeostasis = Math.round((flowScore + pressScore + organScore) / 3);

      document.getElementById('homeostasis').textContent = homeostasis + '%';
      document.getElementById('homeostasis').style.color = homeostasis > 80 ? '#00cc66' : homeostasis > 50 ? '#ffaa00' : '#ff3366';

      const status = count === 0 ? 'Offline' : count < 3 ? 'Partial' : count < 6 ? 'Running' : 'Optimal';
      document.getElementById('viability').textContent = status;
      document.getElementById('viability').style.color = count === 6 ? '#00cc66' : count > 0 ? '#ffaa00' : '#ff3366';
    }

    updateSystem();
  </script>
</body>
</html>
