<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧬 Kenneth's AMAZING Biotech Adventure! 🚀</title>
    <meta name="description" content="Kenneth builds incredible bio-systems! A fun, colorful puzzle game about biotechnology.">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="game-styles.css">

    <!-- EMERGENCY FIX: Force all buttons clickable -->
    <style>
        button, .menu-btn, .level-card, .collection-card, .category-btn, .era-tab, .back-btn {
            pointer-events: auto !important;
            position: relative;
            z-index: 9000 !important;
        }
        #menu-screen.active .menu-content,
        #menu-screen.active .menu-buttons {
            pointer-events: auto !important;
            z-index: 9000 !important;
        }
        #loading-screen:not(.active) {
            display: none !important;
            pointer-events: none !important;
        }
        /* Kill any invisible overlays */
        .screen::before, .screen::after {
            pointer-events: none !important;
        }
        /* EMERGENCY: Ensure game grid is visible */
        #game-screen.active {
            display: flex !important;
            opacity: 1 !important;
        }
        #game-screen .game-main {
            display: flex !important;
            flex: 1 !important;
        }
        #game-screen .grid-container {
            display: flex !important;
            flex: 1 !important;
            min-height: 300px !important;
        }
        #game-screen .grid-wrapper {
            min-width: 300px !important;
            min-height: 300px !important;
        }
        #game-screen #game-grid {
            display: grid !important;
            min-width: 280px !important;
            min-height: 280px !important;
        }
        .grid-cell {
            min-width: 60px !important;
            min-height: 60px !important;
        }
    </style>
</head>
<body>
    <!-- ═══════════════════════════════════════════════════════════════════════
         PARTICLE CANVAS - Background magic!
         ═══════════════════════════════════════════════════════════════════════ -->
    <canvas id="particle-canvas"></canvas>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         LOADING SCREEN - Kenneth's Lab is powering up!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="loading-screen" class="screen active">
        <div class="loading-content">
            <div class="loading-logo">
                <div class="dna-helix">
                    <div class="dna-strand strand-1"></div>
                    <div class="dna-strand strand-2"></div>
                    <div class="dna-base base-1"></div>
                    <div class="dna-base base-2"></div>
                    <div class="dna-base base-3"></div>
                    <div class="dna-base base-4"></div>
                </div>
            </div>
            <h1 class="loading-title">
                <span class="title-kenneth">Kenneth's</span>
                <span class="title-biotech">BIOTECH</span>
                <span class="title-adventure">Adventure!</span>
            </h1>
            <div class="loading-bar-container">
                <div class="loading-bar">
                    <div id="loading-progress" class="loading-progress"></div>
                    <div class="loading-glow"></div>
                </div>
                <div class="loading-bubbles">
                    <div class="bubble"></div>
                    <div class="bubble"></div>
                    <div class="bubble"></div>
                    <div class="bubble"></div>
                    <div class="bubble"></div>
                </div>
            </div>
            <p id="loading-text" class="loading-text">Initializing bio-systems...</p>
            <p id="loading-percent" class="loading-percent">0%</p>
            <div class="loading-tips">
                <p class="tip">💡 <span id="loading-tip">Tip: Connect matching ports to create powerful synergies!</span></p>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN MENU - Kenneth's Command Center!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="menu-screen" class="screen">
        <div class="menu-background">
            <div class="floating-cells">
                <div class="cell cell-1"></div>
                <div class="cell cell-2"></div>
                <div class="cell cell-3"></div>
                <div class="cell cell-4"></div>
                <div class="cell cell-5"></div>
            </div>
        </div>
        
        <div class="menu-content">
            <header class="menu-header">
                <div class="logo-container">
                    <div class="logo-icon">🧬</div>
                    <h1 class="game-title">
                        <span class="kenneth-name">Kenneth's</span>
                        <span class="biotech-text">BIOTECH</span>
                        <span class="adventure-text">Adventure!</span>
                    </h1>
                </div>
                
                <!-- Player Status Card -->
                <div class="player-card">
                    <div class="player-avatar">
                        <div class="avatar-ring"></div>
                        <span class="avatar-emoji">🧑‍🔬</span>
                        <div class="level-badge" id="menu-level-badge">1</div>
                    </div>
                    <div class="player-info">
                        <h2 class="player-name">Kenneth</h2>
                        <p class="player-title" id="menu-player-title">Bio-Scientist</p>
                        <div class="xp-bar-mini">
                            <div class="xp-fill-mini" id="menu-xp-fill"></div>
                        </div>
                    </div>
                    <div class="player-stats-mini">
                        <div class="stat-mini">
                            <span class="stat-icon">⭐</span>
                            <span class="stat-value" id="menu-total-stars">0</span>
                        </div>
                        <div class="stat-mini">
                            <span class="stat-icon">🏆</span>
                            <span class="stat-value" id="menu-high-score">0</span>
                        </div>
                    </div>
                </div>
            </header>
            
            <nav class="menu-buttons">
                <button class="menu-btn primary-btn" id="btn-play" data-action="play" onclick="console.log('PLAY clicked!'); window.gamePlay();">
                    <span class="btn-icon">🚀</span>
                    <span class="btn-text">PLAY!</span>
                    <span class="btn-subtitle">Continue your adventure</span>
                    <div class="btn-particles"></div>
                </button>

                <button class="menu-btn secondary-btn" id="btn-levels" data-action="levels" onclick="window.gameShowScreen('levels');">
                    <span class="btn-icon">🗺️</span>
                    <span class="btn-text">Choose Level</span>
                    <span class="btn-subtitle">Pick a mission</span>
                </button>

                <button class="menu-btn secondary-btn" id="btn-sandbox" data-action="sandbox" onclick="window.gameSandbox();">
                    <span class="btn-icon">🔬</span>
                    <span class="btn-text">Free Build</span>
                    <span class="btn-subtitle">Create anything!</span>
                </button>

                <button class="menu-btn secondary-btn" id="btn-collection" data-action="collection" onclick="window.gameShowScreen('collection');">
                    <span class="btn-icon">📚</span>
                    <span class="btn-text">Bio-Collection</span>
                    <span class="btn-subtitle">Your discoveries</span>
                </button>

                <button class="menu-btn secondary-btn" id="btn-tutorial" data-action="tutorial" onclick="window.gameShowScreen('tutorial');">
                    <span class="btn-icon">📖</span>
                    <span class="btn-text">How to Play</span>
                    <span class="btn-subtitle">Learn the basics</span>
                </button>

                <button class="menu-btn icon-btn" id="btn-settings" data-action="settings" onclick="window.gameShowScreen('settings');">
                    <span class="btn-icon">⚙️</span>
                </button>
            </nav>
            
            <footer class="menu-footer">
                <p class="version">v2.0 ✨ Made with 💜 for Kenneth</p>
            </footer>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         LEVEL SELECT SCREEN - Choose Your Mission!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="levels-screen" class="screen">
        <div class="screen-header">
            <button class="back-btn" data-action="back-to-menu" onclick="window.gameShowScreen('menu');">
                <span>←</span> Back
            </button>
            <h1 class="screen-title">🗺️ Choose Your Mission!</h1>
            <div class="header-spacer"></div>
        </div>
        
        <div class="levels-container">
            <div class="era-tabs">
                <button class="era-tab active" data-era="1">
                    <span class="era-icon">🫀</span>
                    <span class="era-name">Basic Organs</span>
                </button>
                <button class="era-tab" data-era="2">
                    <span class="era-icon">🧫</span>
                    <span class="era-name">Organoids</span>
                    <span class="lock-icon">🔒</span>
                </button>
                <button class="era-tab" data-era="3">
                    <span class="era-icon">🔬</span>
                    <span class="era-name">MPS Systems</span>
                    <span class="lock-icon">🔒</span>
                </button>
                <button class="era-tab" data-era="4">
                    <span class="era-icon">🤖</span>
                    <span class="era-name">Digital Twins</span>
                    <span class="lock-icon">🔒</span>
                </button>
            </div>
            
            <div class="levels-grid" id="levels-grid">
                <!-- Dynamically populated -->
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         GAME SCREEN - Kenneth's Laboratory!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="game-screen" class="screen">
        <!-- Game Header -->
        <header class="game-header">
            <div class="header-left">
                <button class="game-btn icon-btn" id="btn-pause" title="Pause Game">
                    <span>⏸️</span>
                </button>
                <div class="level-info">
                    <span class="level-name" id="game-level-name">Level 1-1</span>
                    <span class="level-subtitle" id="game-level-subtitle">Build a Heart System</span>
                </div>
            </div>
            
            <div class="header-center">
                <div class="timer-display" id="timer-container">
                    <div class="timer-icon">⏱️</div>
                    <div class="timer-value" id="game-timer">3:00</div>
                    <div class="timer-bar">
                        <div class="timer-fill" id="timer-fill"></div>
                    </div>
                </div>
            </div>
            
            <div class="header-right">
                <div class="score-display">
                    <div class="score-label">SCORE</div>
                    <div class="score-value" id="game-score">0</div>
                    <div class="combo-indicator" id="combo-indicator">
                        <span class="combo-text">COMBO</span>
                        <span class="combo-value" id="combo-value">x1.0</span>
                    </div>
                </div>
                <div class="target-display">
                    <div class="target-label">TARGET</div>
                    <div class="target-value" id="game-target">1000</div>
                </div>
            </div>
        </header>
        
        <!-- Main Game Area -->
        <main class="game-main">
            <!-- Left Panel - Objectives & Tips -->
            <aside class="game-sidebar left-sidebar">
                <div class="objectives-panel">
                    <h3 class="panel-title">🎯 Objectives</h3>
                    <ul class="objectives-list" id="objectives-list">
                        <!-- Dynamically populated -->
                    </ul>
                </div>
                
                <div class="tips-panel">
                    <h3 class="panel-title">💡 Kenneth's Tips</h3>
                    <div class="tip-content" id="current-tip">
                        <p>Drag modules from the tray to the grid!</p>
                    </div>
                </div>
                
                <div class="power-ups-panel">
                    <h3 class="panel-title">⚡ Power-Ups</h3>
                    <div class="power-ups-grid">
                        <button class="power-up-btn" data-power="hint" title="Get a Hint">
                            <span class="power-icon">💡</span>
                            <span class="power-count">3</span>
                        </button>
                        <button class="power-up-btn" data-power="undo" title="Undo Last Move">
                            <span class="power-icon">↩️</span>
                            <span class="power-count">5</span>
                        </button>
                        <button class="power-up-btn" data-power="boost" title="Score Boost">
                            <span class="power-icon">🚀</span>
                            <span class="power-count">2</span>
                        </button>
                        <button class="power-up-btn" data-power="time" title="Extra Time">
                            <span class="power-icon">⏰</span>
                            <span class="power-count">1</span>
                        </button>
                    </div>
                </div>
            </aside>
            
            <!-- Center - The Grid! -->
            <div class="grid-container">
                <div class="grid-wrapper">
                    <div class="grid-background"></div>
                    <div class="grid" id="game-grid">
                        <!-- Grid cells generated by JS -->
                    </div>
                    <svg class="connections-layer" id="connections-svg">
                        <!-- Connection lines drawn here -->
                    </svg>
                    <div class="grid-effects" id="grid-effects">
                        <!-- Particle effects layer -->
                    </div>
                </div>
                
                <!-- Feedback Area -->
                <div class="feedback-area" id="feedback-area">
                    <!-- Encouragement messages appear here -->
                </div>
            </div>
            
            <!-- Right Panel - Module Info -->
            <aside class="game-sidebar right-sidebar">
                <div class="selected-module-panel" id="selected-module-panel">
                    <h3 class="panel-title">📋 Module Info</h3>
                    <div class="module-preview" id="module-preview">
                        <p class="empty-state">Select a module to see details!</p>
                    </div>
                </div>
                
                <div class="synergy-panel">
                    <h3 class="panel-title">✨ Active Synergies</h3>
                    <div class="synergy-list" id="synergy-list">
                        <p class="empty-state">Connect modules to create synergies!</p>
                    </div>
                </div>
                
                <div class="achievements-mini">
                    <h3 class="panel-title">🏆 Recent</h3>
                    <div class="recent-achievements" id="recent-achievements">
                        <!-- Mini achievement icons -->
                    </div>
                </div>
            </aside>
        </main>
        
        <!-- Module Tray -->
        <footer class="module-tray">
            <div class="tray-header">
                <h3 class="tray-title">🧬 Your Bio-Modules</h3>
                <div class="tray-filters">
                    <button class="filter-btn active" data-filter="all">All</button>
                    <button class="filter-btn" data-filter="organs">🫀 Organs</button>
                    <button class="filter-btn" data-filter="organoids">🧫 Organoids</button>
                    <button class="filter-btn" data-filter="connectors">🔗 Connectors</button>
                </div>
            </div>
            <div class="tray-scroll">
                <div class="module-list" id="module-tray">
                    <!-- Modules populated by JS -->
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         TUTORIAL SCREEN - Learn with Kenneth!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="tutorial-screen" class="screen">
        <div class="tutorial-container">
            <div class="tutorial-header">
                <button class="back-btn" data-action="back-to-menu" onclick="window.gameShowScreen('menu');">← Back</button>
                <h1>📖 How to Play</h1>
                <div class="tutorial-progress">
                    <span id="tutorial-step">1</span> / <span id="tutorial-total">6</span>
                </div>
            </div>
            
            <div class="tutorial-content" id="tutorial-content">
                <!-- Tutorial steps rendered here -->
            </div>
            
            <div class="tutorial-nav">
                <button class="tutorial-btn" id="tutorial-prev">← Previous</button>
                <div class="tutorial-dots" id="tutorial-dots"></div>
                <button class="tutorial-btn primary" id="tutorial-next">Next →</button>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         COLLECTION SCREEN - Kenneth's Bio-Collection!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="collection-screen" class="screen">
        <div class="screen-header">
            <button class="back-btn" data-action="back-to-menu" onclick="window.gameShowScreen('menu');">← Back</button>
            <h1 class="screen-title">📚 Kenneth's Bio-Collection</h1>
            <div class="collection-stats">
                <span id="collection-count">0</span> / <span id="collection-total">0</span> Discovered
            </div>
        </div>
        
        <div class="collection-container">
            <div class="collection-categories">
                <button class="category-btn active" data-category="all">🌟 All</button>
                <button class="category-btn" data-category="organs">🫀 Organs</button>
                <button class="category-btn" data-category="organoids">🧫 Organoids</button>
                <button class="category-btn" data-category="mps">🔬 MPS</button>
                <button class="category-btn" data-category="digital">💻 Digital</button>
                <button class="category-btn" data-category="connectors">🔗 Connectors</button>
            </div>
            
            <div class="collection-grid" id="collection-grid">
                <!-- Module cards populated here -->
            </div>
        </div>
        
        <!-- Module Detail Modal -->
        <div class="module-detail-modal" id="module-detail-modal">
            <div class="modal-content">
                <button class="modal-close" id="close-module-detail">×</button>
                <div class="modal-body" id="module-detail-content">
                    <!-- Module details -->
                </div>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SETTINGS SCREEN
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="settings-screen" class="screen">
        <div class="settings-container">
            <div class="screen-header">
                <button class="back-btn" data-action="back-to-menu" onclick="window.gameShowScreen('menu');">← Back</button>
                <h1 class="screen-title">⚙️ Settings</h1>
                <div class="header-spacer"></div>
            </div>
            
            <div class="settings-content">
                <section class="settings-section">
                    <h2>🔊 Sound</h2>
                    <div class="setting-item">
                        <label>Music Volume</label>
                        <input type="range" id="music-volume" min="0" max="100" value="70">
                        <span class="volume-value">70%</span>
                    </div>
                    <div class="setting-item">
                        <label>Sound Effects</label>
                        <input type="range" id="sfx-volume" min="0" max="100" value="80">
                        <span class="volume-value">80%</span>
                    </div>
                </section>
                
                <section class="settings-section">
                    <h2>🎨 Visuals</h2>
                    <div class="setting-item">
                        <label>Particle Effects</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="particles-toggle" checked>
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <label>Screen Shake</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="shake-toggle" checked>
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <label>High Contrast Mode</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="contrast-toggle">
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <label>Reduced Motion</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="motion-toggle">
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                </section>
                
                <section class="settings-section">
                    <h2>🎮 Gameplay</h2>
                    <div class="setting-item">
                        <label>Show Hints</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="hints-toggle" checked>
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <label>Auto-Rotate Modules</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="autorotate-toggle" checked>
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                </section>
                
                <section class="settings-section danger-zone">
                    <h2>⚠️ Data</h2>
                    <button class="danger-btn" id="reset-progress">Reset All Progress</button>
                </section>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         PAUSE MODAL
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="pause-modal" class="modal">
        <div class="modal-content pause-content">
            <h2>⏸️ Game Paused</h2>
            <p class="pause-message">Take a break, Kenneth! The lab will wait for you. 🧬</p>
            <div class="pause-stats">
                <div class="pause-stat">
                    <span class="stat-label">Current Score</span>
                    <span class="stat-value" id="pause-score">0</span>
                </div>
                <div class="pause-stat">
                    <span class="stat-label">Time Left</span>
                    <span class="stat-value" id="pause-time">0:00</span>
                </div>
            </div>
            <div class="pause-buttons">
                <button class="modal-btn primary" id="resume-game">▶️ Resume</button>
                <button class="modal-btn" id="restart-level">🔄 Restart</button>
                <button class="modal-btn" id="quit-to-menu">🏠 Main Menu</button>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         LEVEL COMPLETE MODAL - CELEBRATION TIME!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="complete-modal" class="modal">
        <div class="modal-content complete-content">
            <div class="celebration-effects">
                <div class="confetti-container" id="confetti-container"></div>
                <div class="star-burst" id="star-burst"></div>
            </div>
            
            <h2 class="complete-title" id="complete-title">🎉 AMAZING JOB, KENNETH! 🎉</h2>
            
            <div class="stars-display" id="stars-display">
                <div class="star star-1">⭐</div>
                <div class="star star-2">⭐</div>
                <div class="star star-3">⭐</div>
            </div>
            
            <div class="complete-message" id="complete-message">
                You're a BRILLIANT Bio-Scientist!
            </div>
            
            <div class="complete-stats">
                <div class="complete-stat">
                    <div class="stat-icon">🏆</div>
                    <div class="stat-info">
                        <span class="stat-label">Final Score</span>
                        <span class="stat-value" id="final-score">0</span>
                    </div>
                </div>
                <div class="complete-stat">
                    <div class="stat-icon">🔗</div>
                    <div class="stat-info">
                        <span class="stat-label">Connections</span>
                        <span class="stat-value" id="final-connections">0</span>
                    </div>
                </div>
                <div class="complete-stat">
                    <div class="stat-icon">✨</div>
                    <div class="stat-info">
                        <span class="stat-label">Synergies</span>
                        <span class="stat-value" id="final-synergies">0</span>
                    </div>
                </div>
                <div class="complete-stat">
                    <div class="stat-icon">⏱️</div>
                    <div class="stat-info">
                        <span class="stat-label">Time Bonus</span>
                        <span class="stat-value" id="final-time-bonus">+0</span>
                    </div>
                </div>
            </div>
            
            <div class="xp-reward">
                <div class="xp-icon">✨</div>
                <span class="xp-text">+<span id="xp-earned">100</span> XP</span>
                <div class="xp-bar-reward">
                    <div class="xp-fill-reward" id="xp-fill-reward"></div>
                </div>
            </div>
            
            <div class="unlocks-section" id="unlocks-section" style="display: none;">
                <h3>🎁 New Unlocks!</h3>
                <div class="unlocks-list" id="unlocks-list"></div>
            </div>
            
            <div class="complete-buttons">
                <button class="modal-btn" id="complete-menu">🏠 Menu</button>
                <button class="modal-btn" id="complete-retry">🔄 Retry</button>
                <button class="modal-btn primary" id="complete-next">Next Level ➡️</button>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         GAME OVER MODAL - Try Again!
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="gameover-modal" class="modal">
        <div class="modal-content gameover-content">
            <h2>⏰ Time's Up!</h2>
            <p class="gameover-message">
                Don't worry, Kenneth! Every scientist learns from trying. 
                You've got this! 💪
            </p>
            
            <div class="gameover-stats">
                <div class="gameover-stat">
                    <span class="stat-label">Score Reached</span>
                    <span class="stat-value" id="gameover-score">0</span>
                </div>
                <div class="gameover-stat">
                    <span class="stat-label">Target Was</span>
                    <span class="stat-value" id="gameover-target">0</span>
                </div>
            </div>
            
            <div class="gameover-tip">
                <span class="tip-icon">💡</span>
                <p id="gameover-tip">Try connecting modules with matching port colors for bonus points!</p>
            </div>
            
            <div class="gameover-buttons">
                <button class="modal-btn" id="gameover-menu">🏠 Menu</button>
                <button class="modal-btn primary" id="gameover-retry">🔄 Try Again!</button>
            </div>
        </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         TOAST NOTIFICATIONS
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="toast-container" class="toast-container"></div>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         FLOATING ENCOURAGEMENT
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="floating-message" class="floating-message"></div>
    
