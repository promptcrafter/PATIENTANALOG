<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lung-on-Chip Flow Challenge | Patient Analog</title>
    <style>
    :root { --bg: #000814; --sapphire: #0055ff; --emerald: #00cc66; --crimson: #ff3366; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: var(--bg); color: white; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .game-container { max-width: 500px; padding: 30px; text-align: center; }
    h1 { font-size: 1.5rem; margin-bottom: 10px; }
    .subtitle { color: #888; margin-bottom: 20px; font-size: 14px; }
    .stats { display: flex; justify-content: center; gap: 30px; margin-bottom: 30px; }
    .stat-value { font-size: 2rem; font-weight: bold; }
    .stat-label { font-size: 12px; color: #666; }
    .lung-visual {
      width: 300px; height: 200px; margin: 0 auto 30px;
      background: linear-gradient(180deg, rgba(0,85,255,0.1), rgba(0,85,255,0.05));
      border: 2px solid rgba(0,85,255,0.3); border-radius: 100px 100px 50px 50px;
      position: relative; overflow: hidden;
    }
    .lung-fill {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: linear-gradient(180deg, rgba(0,200,255,0.4), rgba(0,100,255,0.6));
      transition: height 0.1s;
    }
    .o2-bar, .co2-bar { height: 20px; border-radius: 10px; margin: 10px 0; transition: width 0.3s; }
    .o2-bar { background: var(--sapphire); }
    .co2-bar { background: var(--crimson); }
    .inhale-btn {
      width: 200px; height: 200px; border-radius: 50%;
      background: linear-gradient(145deg, #003399, #0055ff);
      border: 4px solid rgba(255,255,255,0.2);
      color: white; font-size: 1.2rem; font-weight: bold;
      cursor: pointer; transition: all 0.1s; user-select: none;
    }
    .inhale-btn:active, .inhale-btn.active {
      transform: scale(0.95);
      background: linear-gradient(145deg, #0055ff, #0077ff);
      box-shadow: 0 0 40px rgba(0,85,255,0.5);
    }
    .warning { color: var(--crimson); font-weight: bold; margin-top: 15px; min-height: 24px; }
  </style>
</head>
<body>
  <div class="game-container">
    <h1>🫁 Lung-on-Chip Flow Challenge</h1>
    <p class="subtitle">Control airflow through a breathing lung chip! Maintain optimal oxygen exchange.</p>

    <div class="stats">
      <div><div class="stat-value" id="o2sat">98%</div><div class="stat-label">O₂ Saturation</div></div>
      <div><div class="stat-value" id="breaths">0</div><div class="stat-label">Breaths</div></div>
    </div>

    <div class="lung-visual">
      <div class="lung-fill" id="lungFill" style="height: 20%;"></div>
    </div>

    <div style="max-width: 300px; margin: 0 auto 20px;">
      <div style="display: flex; justify-content: space-between; font-size: 12px;"><span>O₂</span><span id="o2val">50%</span></div>
      <div class="o2-bar" id="o2bar" style="width: 50%;"></div>
      <div style="display: flex; justify-content: space-between; font-size: 12px;"><span>CO₂</span><span id="co2val">20%</span></div>
      <div class="co2-bar" id="co2bar" style="width: 20%;"></div>
    </div>

    <button class="inhale-btn" id="inhaleBtn">🌬️ INHALE<br><small>Hold to breathe in</small></button>
    <div class="warning" id="warning"></div>
  </div>

  <script>
    const lungFill = document.getElementById('lungFill');
    const inhaleBtn = document.getElementById('inhaleBtn');
    const o2bar = document.getElementById('o2bar');
    const co2bar = document.getElementById('co2bar');
    const o2val = document.getElementById('o2val');
    const co2val = document.getElementById('co2val');
    const o2sat = document.getElementById('o2sat');
    const breathsEl = document.getElementById('breaths');
    const warning = document.getElementById('warning');

    let isInhaling = false;
    let lungCapacity = 20;
    let o2 = 50;
    let co2 = 20;
    let breaths = 0;
    let saturation = 98;

    function update() {
      if (isInhaling && lungCapacity < 100) {
        lungCapacity += 3;
        o2 = Math.min(100, o2 + 2);
        co2 = Math.max(0, co2 - 1);
      } else if (!isInhaling && lungCapacity > 10) {
        lungCapacity -= 2;
        if (lungCapacity < 30) {
          o2 = Math.max(0, o2 - 0.5);
          co2 = Math.min(100, co2 + 0.3);
        }
      }

      // Calculate saturation
      saturation = Math.min(100, Math.max(70, 70 + (o2 * 0.3) - (co2 * 0.1)));

      lungFill.style.height = lungCapacity + '%';
      o2bar.style.width = o2 + '%';
      co2bar.style.width = co2 + '%';
      o2val.textContent = Math.round(o2) + '%';
      co2val.textContent = Math.round(co2) + '%';
      o2sat.textContent = Math.round(saturation) + '%';

      // Warnings
      if (saturation < 90) warning.textContent = '⚠️ LOW OXYGEN - BREATHE!';
      else if (co2 > 60) warning.textContent = '⚠️ HIGH CO₂ - EXHALE!';
      else warning.textContent = '';

      requestAnimationFrame(update);
    }

    inhaleBtn.addEventListener('mousedown', () => { isInhaling = true; inhaleBtn.classList.add('active'); });
    inhaleBtn.addEventListener('mouseup', () => { isInhaling = false; inhaleBtn.classList.remove('active'); breaths++; breathsEl.textContent = breaths; });
    inhaleBtn.addEventListener('mouseleave', () => { isInhaling = false; inhaleBtn.classList.remove('active'); });
    inhaleBtn.addEventListener('touchstart', (e) => { e.preventDefault(); isInhaling = true; inhaleBtn.classList.add('active'); });
    inhaleBtn.addEventListener('touchend', () => { isInhaling = false; inhaleBtn.classList.remove('active'); breaths++; breathsEl.textContent = breaths; });

    update();
  </script>
</body>
</html>
